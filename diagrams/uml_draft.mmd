classDiagram
    %% PawPal+ object design (draft).

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) void
    }
    class Pet {
        +str name
        +str species
        +str energy_level
        +str notes
    }
    class Responsibility {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str recurrence
        +str fixed_time
        +bool essential
        +priority_weight() int
    }
    class Constraints {
        +int available_minutes
        +str day_start
        +str day_end
        +str day_of_week
        +dict preferences
        +has_time_for(remaining, duration) bool
    }
    class Plan {
        +Pet pet
        +list~Responsibility~ responsibilities
        +Constraints constraints
        +str date
        +list~dict~ scheduled
        +list~Responsibility~ skipped
        +Explanation explanation
        +build() void
        +total_minutes() int
        +as_rows() list
    }
    class Explanation {
        +str summary
        +str strategy
        +list~str~ reasons
        +list~str~ skipped_reasons
        +as_text() str
    }

    %% scheduled: list of dicts, each {responsibility, start_time, end_time}
    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Responsibility : has
    Plan --> Pet : built for
    Plan --> Responsibility : schedules
    Plan --> Constraints : uses
    Plan "1" --> "1" Explanation : explained by
