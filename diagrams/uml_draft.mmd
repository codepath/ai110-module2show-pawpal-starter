classDiagram
    %% PawPal+ object design (draft).

    class Owner {
        +str name
        +list~Pet~ pets
        +dict preferences
        +add_pet(pet) void
    }
    class Pet {
        +str name
        +str species
        +str energy_level
        +str notes
        +list~Responsibility~ responsibilities
    }
    class Responsibility {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str recurrence
        +str weekday
        +str fixed_time
        +bool essential
        +priority_weight() int
    }
    class Constraints {
        +int available_minutes
        +str day_start
        +str day_end
        +str day_of_week
        +has_time_for(remaining, duration) bool
        +window_minutes() int
    }
    class Plan {
        +Owner owner
        +Pet pet
        +Constraints constraints
        +str date
        +list~Scheduler~ scheduled
        +list~Responsibility~ skipped
        +Explanation explanation
        +build() void
        +total_minutes() int
        +as_rows() list
    }
    class Scheduler {
        +Responsibility responsibility
        +str start_time
        +str end_time
    }
    class Explanation {
        +str summary
        +str strategy
        +list~str~ reasons
        +list~str~ skipped_reasons
        +as_text() str
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Responsibility : has
    Plan --> Owner : built for
    Plan --> Pet : built for
    Plan --> Constraints : uses
    Plan "1" --> "*" Scheduler : produces
    Scheduler --> Responsibility : for
    Plan "1" --> "1" Explanation : explained by
