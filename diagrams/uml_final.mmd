classDiagram
    %% PawPal+ class diagram — aligned with pawpal_system.py

    class Owner {
        +str name
        +list~Pet~ pets
        +Constraints constraints
        +add_pet(pet Pet) None
        +remove_pet(name str) None
        +get_pet(name str) Pet
        +all_tasks() list~PetTask~
        +tasks_for(pet_name str, status str) list~PetTask~
        +tasks_by_status(status str) list~PetTask~
        +build_plan(day date) DailyPlan
    }

    class Pet {
        +str name
        +str species
        +list~PetTask~ tasks
        +add_task(task PetTask) None
        +remove_task(title str) None
    }

    class PetTask {
        +dict PRIORITY_WEIGHTS$
        +dict FREQUENCY_DAYS$
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +bool recurring
        +str time
        +date due_date
        +str status
        +mark_complete() PetTask
        +priority_weight() int
        +summary() str
        -_next_occurrence() PetTask
    }

    class Constraints {
        +int available_minutes
        +str preferred_start
        +list~str~ preferred_order
        +bool skip_low_priority
        +allows(task PetTask, used_minutes int) bool
        +remaining_minutes(used_minutes int) int
    }

    class DailyPlan {
        +date day
        +list scheduled
        +list~PetTask~ skipped
        +str reasoning
        +build(tasks list~PetTask~, constraints Constraints, day date) DailyPlan$
        +add(task PetTask, start_time str) None
        +total_minutes() int
        +explain() str
        +sort_by_time(tasks list~PetTask~) list~PetTask~$
        +detect_conflicts(pets list~Pet~) list~str~$
    }

    Owner "1" *-- "many" Pet : owns
    Pet "1" *-- "many" PetTask : has
    Owner "1" --> "0..1" Constraints : sets
    Owner ..> DailyPlan : builds
    DailyPlan ..> PetTask : schedules
    DailyPlan ..> Pet : detects conflicts
    DailyPlan ..> Constraints : respects
    PetTask ..> PetTask : spawns next occurrence
