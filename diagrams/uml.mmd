classDiagram
    %% PawPal+ class diagram (draft). Refine to match your Python implementation as it grows.

    class Owner {
        +str name
        +list~Pet~ pets
        +Constraints constraints
        +add_pet(pet Pet) None
        +remove_pet(name str) None
        +get_pet(name str) Pet
        +all_tasks() list~PetTask~
        +tasks_for(pet_name str) list~PetTask~
        +build_plan(day date) DailyPlan
    }

    class Pet {
        +str name
        +str species
        +list~PetTask~ tasks
        +add_task(task PetTask) None
        +remove_task(title str) None
    }

    class PetTask {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +bool recurring
        +str status
        +mark_complete() None
        +priority_weight() int
        +summary() str
    }

    class Constraints {
        +int available_minutes
        +str preferred_start
        +list~str~ preferred_order
        +bool skip_low_priority
        +allows(task PetTask, used_minutes int) bool
        +remaining_minutes(used_minutes int) int
    }

    class DailyPlan {
        +date day
        +list scheduled
        +list~PetTask~ skipped
        +str reasoning
        +build(tasks list~PetTask~, constraints Constraints, day date) DailyPlan$
        +add(task PetTask, start_time str) None
        +total_minutes() int
        +explain() str
    }

    Owner "1" *-- "many" Pet : owns
    Pet "1" *-- "many" PetTask : has
    Owner "1" *-- "1" Constraints : sets
    Owner ..> DailyPlan : builds
    DailyPlan ..> PetTask : schedules
    DailyPlan ..> Constraints : respects
